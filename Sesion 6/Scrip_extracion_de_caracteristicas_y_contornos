if __name__ == "__main__":
    print("================================================================")
    print("   SESIÓN Práctica: CLASIFICADOR DE MONEDAS POR ÁREA CON OPENCV  ")
    print("================================================================")

    # Nombre de tu imagen de entrada (asegúrate que esté en la misma carpeta)
    archivo_entrada = 'monedas.jpg'

    # Instanciar el analizador
    # El umbral de área se ha ajustado a 12,000 píxeles para separar tus monedas.
    analizador = AnalizadorMonedas(umbral_area=12000)
    
    # Ejecutar el proceso
    analizador.procesar_imagen(archivo_entrada)

    print("================================================================")
