import numpy as np
import cv2
import os
from typing import Optional

class AnalizadorGradienteSesionCinco:
    """Clase especializada en el procesamiento de gradientes y análisis de bordes para la Sesión 5."""

    @staticmethod
    def procesar_infografia_gradiente(ruta_imagen: str) -> None:
        """
        Carga la imagen 'safarigradiente.jpg', realiza la conversión a escala de grises,
        calcula los gradientes de Sobel y aplica el detector de bordes Canny.
        """
        if not os.path.exists(ruta_imagen):
            print(f"[ERROR] No se encontró el archivo en disco: '{ruta_imagen}'.")
            return

        # Carga del tensor de color
        imagen_color = cv2.imread(ruta_imagen)
        if imagen_color is None:
            print(f"[ERROR] No se pudo decodificar el archivo '{ruta_imagen}'.")
            return
        
        # Conversión a escala de grises para el procesamiento analítico de gradientes
        imagen_gris = cv2.cvtColor(imagen_color, cv2.COLOR_BGR2GRAY)
        print(f"[INFO] Imagen '{ruta_imagen}' cargada correctamente. Calculando gradientes...")

        # 1. Operador Sobel para cálculo de derivadas espaciales X e Y
        sobel_x = cv2.Sobel(imagen_gris, cv2.CV_64F, 1, 0, ksize=3)
        sobel_y = cv2.Sobel(imagen_gris, cv2.CV_64F, 0, 1, ksize=3)

        abs_sobel_x = cv2.convertScaleAbs(sobel_x)
        abs_sobel_y = cv2.convertScaleAbs(sobel_y)
        sobel_combinado = cv2.addWeighted(abs_sobel_x, 0.5, abs_sobel_y, 0.5, 0)

        # 2. Detector de Bordes Canny
        canny_bordes = cv2.Canny(imagen_gris, 50, 150)

        # Visualización de los resultados en ventanas independientes
        cv2.imshow("1. Infografia Original - Safarigradiente", imagen_color)
        cv2.imshow("2. Gradiente Sobel Combinado", sobel_combinado)
        cv2.imshow("3. Deteccion de Bordes (Canny)", canny_bordes)

        print("[INFO] Análisis de gradientes finalizado. Presiona cualquier tecla para cerrar...")
        cv2.waitKey(0)
        cv2.destroyAllWindows()


