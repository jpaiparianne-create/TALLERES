if __name__ == "__main__":
    print("================================================================")
    print("      SESIÓN 5: CÁLCULO DE GRADIENTES Y BORDES                  ")
    print("================================================================")

    # Nombre oficial de la imagen integrada para esta sesión
    nombre_archivo = 'safarigradiente.jpg'

    # Ejecución del pipeline de la Sesión 5
    AnalizadorGradienteSesionCinco.procesar_infografia_gradiente(nombre_archivo)
    
    print("================================================================")
